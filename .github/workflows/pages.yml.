const state={health:100,energy:82,happy:75,cash:2500,day:1,journal:['Alex arrived in the waterfront district of Kochi.'],near:null};const keys={};let yaw=0,pitch=.22,drag=false,lastX=0,lastY=0;const clock=new THREE.Clock();
function toast(t){const e=document.getElementById('toast');e.textContent=t;e.classList.add('show');clearTimeout(toast.timer);toast.timer=setTimeout(()=>e.classList.remove('show'),2600)}function updateHUD(){for(const [id,v] of [['health',state.health],['energy',state.energy],['happy',state.happy]]){document.getElementById(id).style.width=v+'%';document.getElementById(id+'N').textContent=v+'%'}document.getElementById('cash').textContent='₹'+Math.round(state.cash).toLocaleString('en-IN');document.getElementById('day').textContent=state.day;document.getElementById('location').textContent='Kochi, India · Age 14';document.getElementById('zone').textContent=state.near?state.near.name:'Waterfront district'}
function moveDir(down){if(down)keys[down]=true}function getMove(){let x=0,z=0;if(keys.KeyW||keys.ArrowUp||keys.forward)z-=1;if(keys.KeyS||keys.ArrowDown||keys.back)z+=1;if(keys.KeyA||keys.ArrowLeft||keys.left)x-=1;if(keys.KeyD||keys.ArrowRight||keys.right)x+=1;return{x,z}}
addEventListener('keydown',e=>{keys[e.code]=true;if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Space'].includes(e.code))e.preventDefault();if(e.code==='KeyE'||e.code==='Enter')interact();if(e.code==='Escape')document.getElementById('modal').classList.remove('open')});addEventListener('keyup',e=>keys[e.code]=false);
document.querySelectorAll('[data-move]').forEach(b=>{let k=b.dataset.move;b.addEventListener('pointerdown',e=>{e.preventDefault();keys[k]=true;b.setPointerCapture(e.pointerId)});['pointerup','pointercancel','lostpointercapture'].forEach(ev=>b.addEventListener(ev,()=>keys[k]=false))});renderer.domElement.addEventListener('pointerdown',e=>{if(e.clientX>innerWidth*.35){drag=true;lastX=e.clientX;lastY=e.clientY}});addEventListener('pointerup',()=>drag=false);addEventListener('pointermove',e=>{if(drag){yaw-=(e.clientX-lastX)*.004;pitch=Math.max(-.05,Math.min(.65,pitch+(e.clientY-lastY)*.002));lastX=e.clientX;lastY=e.clientY}});
function interact(){if(state.near){const l=state.near;state.journal.unshift('Visited '+l.name+'. '+l.desc);state.journal=state.journal.slice(0,30);if(l.kind==='park'){state.happy=Math.min(100,state.happy+8);state.energy=Math.max(0,state.energy-3)}if(l.kind==='sport'){state.energy=Math.max(0,state.energy-9);state.health=Math.min(100,state.health+3);state.happy=Math.min(100,state.happy+5)}if(l.kind==='shop'){if(state.cash>=100){state.cash-=100;state.happy=Math.min(100,state.happy+4);toast('You bought a snack for ₹100.')}else toast('Not enough cash for a snack.')}if(l.kind==='home'){state.energy=Math.min(100,state.energy+22);state.health=Math.min(100,state.health+5)}if(l.kind==='school'){state.happy=Math.max(0,state.happy-1);state.journal.unshift('You attended class and learned something new.')}if(l.kind==='bus'){state.cash=Math.max(0,state.cash-50);toast('You paid ₹50 bus fare and explored the nearby area.')}updateHUD();if(l.kind!=='shop'&&l.kind!=='bus')toast(l.desc)}else{toast('Explore the area and walk closer to a marked place to interact.')} }
document.getElementById('interact').onclick=interact;const modal=document.getElementById('modal');function openModal(title,text){document.getElementById('modalTitle').textContent=title;document.getElementById('modalText').textContent=text;modal.classList.add('open')}document.getElementById('close').onclick=()=>modal.classList.remove('open');document.getElementById('journalBtn').onclick=()=>openModal('Life journal',state.journal.join('\n\n'));document.getElementById('mapBtn').onclick=()=>openModal('Neighbourhood map','You are in Kochi. Waterfront Park is west, School is east, Sports Ground is north-west, and Home is near the centre. The glowing yellow markers show places you can visit.');document.getElementById('statsBtn').onclick=()=>openModal('Character stats',`Health: ${state.health}% · Energy: ${state.energy}% · Happiness: ${state.happy}% · Cash: ₹${state.cash.toLocaleString('en-IN')} · Journal entries: ${state.journal.length}`);document.getElementById('rest').onclick=()=>{state.energy=Math.min(100,state.energy+18);state.health=Math.min(100,state.health+4);state.day++;state.journal.unshift('Alex rested and recovered energy.');updateHUD();toast('Rested. Energy restored.');};document.getElementById('play').onclick=()=>{state.energy=Math.max(0,state.energy-10);state.health=Math.min(100,state.health+2);state.happy=Math.min(100,state.happy+8);state.journal.unshift('Alex practised sport and improved fitness.');updateHUD();toast('Practice complete.');};
function animate(){requestAnimationFrame(animate);const dt=Math.min(clock.getDelta(),.04);const m=getMove();if(m.x||m.z){let forward=new THREE.Vector3(-Math.sin(yaw),0,-Math.cos(yaw));let right=new THREE.Vector3(Math.cos(yaw),0,-Math.sin(yaw));let dir=forward.multiplyScalar(m.z*-1).add(right.multiplyScalar(m.x)).normalize();player.position.addScaledVector(dir,dt*9);player.rotation.y=Math.atan2(dir.x,dir.z);state.energy=Math.max(0,state.energy-dt*.23)}player.position.x=THREE.MathUtils.clamp(player.position.x,-115,115);player.position.z=THREE.MathUtils.clamp(player.position.z,-55,90);const target=new THREE.Vector3(player.position.x,2.5,player.position.z);const back=new THREE.Vector3(Math.sin(yaw)*10,5+pitch*5,Math.cos(yaw)*10);camera.position.lerp(target.clone().add(back),1-Math.pow(.001,dt));camera.lookAt(target);state.near=null;let closest=Infinity;for(const l of landmarks){l.marker.position.y=5.1+Math.sin(performance.now()*.003+l.x)*.22;const d=Math.hypot(player.position.x-l.x,player.position.z-l.z);if(d<7&&d<closest){closest=d;state.near=l}}npcs.forEach(n=>{n.g.position.x+=Math.sin(performance.now()*.0003+n.phase)*dt*.3;n.g.position.z+=Math.cos(performance.now()*.0004+n.phase)*dt*.25});updateHUD();renderer.render(scene,camera)}
addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});updateHUD();toast('Welcome to Kochi. Explore your world!');animate();
