<title>LIFE ON EARTH — Playable Prototype</title>
<style>
:root{--bg:#0a1020;--panel:#141e34;--panel2:#1b2945;--line:#30415f;--text:#eef4ff;--muted:#a5b5d0;--mint:#6ce3bb;--blue:#90baff;--gold:#f5ce77;--red:#ff929b}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#1b2b4c,#0a1020 60%);color:var(--text);font:15px/1.45 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}button,input,select{font:inherit}button{cursor:pointer;border:1px solid var(--line);border-radius:11px;padding:9px 12px;background:#22314f;color:var(--text)}button:hover{border-color:var(--mint);transform:translateY(-1px)}button:disabled{opacity:.35;cursor:not-allowed;transform:none}.wrap{max-width:1240px;margin:auto;padding:20px}.top{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:16px}.brand{display:flex;gap:12px;align-items:center}.logo{height:46px;width:46px;border-radius:15px;display:grid;place-items:center;background:linear-gradient(135deg,var(--mint),var(--blue));color:#081322;font-size:26px;font-weight:900}.eyebrow{font-size:10px;color:var(--mint);font-weight:850;letter-spacing:.17em}.brand h1{margin:0;font-size:22px;letter-spacing:.04em}.sub{font-size:12px;color:var(--muted)}.topbuttons{display:flex;gap:7px;flex-wrap:wrap}.primary{background:var(--mint);color:#071522;border-color:var(--mint);font-weight:800}.danger{background:#492338;border-color:#804052}.layout{display:grid;grid-template-columns:285px minmax(0,1fr);gap:15px}.stack,.main{display:grid;gap:15px;align-content:start}.card{border:1px solid var(--line);border-radius:17px;padding:16px;background:linear-gradient(150deg,#192642f5,#111a2ef5);box-shadow:0 12px 35px #0002}.card h2{font-size:13px;letter-spacing:.1em;text-transform:uppercase;margin:0 0 12px;color:#dce8ff}.person{display:flex;gap:11px;align-items:center}.avatar{height:62px;width:62px;display:grid;place-items:center;border-radius:19px;font-size:34px;background:linear-gradient(140deg,#e7bd91,#9d684f);border:1px solid #ffffff30}.name{font-size:20px;font-weight:850}.chips{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.chip{font-size:11px;padding:4px 8px;border:1px solid var(--line);border-radius:99px;color:#d0def5;background:#0d172b}.cashlabel{font-size:10px;letter-spacing:.13em;color:var(--muted);margin-top:15px}.cash{font-size:27px;font-weight:900;color:var(--mint)}.stat{margin:11px 0}.stathead{display:flex;justify-content:space-between;font-size:12px;margin-bottom:5px}.bar{height:7px;background:#091123;border-radius:99px;overflow:hidden}.fill{height:100%;width:50%;border-radius:99px;background:linear-gradient(90deg,var(--mint),var(--blue));transition:width .3s}.hero{min-height:200px;background:linear-gradient(110deg,#1a2e4bed,#17233bbb),radial-gradient(circle at 90% 5%,#6ce3bb55,transparent 40%);overflow:hidden;position:relative}.hero:after{content:"";position:absolute;right:-25px;bottom:-90px;width:300px;height:230px;opacity:.5;background:repeating-linear-gradient(90deg,transparent 0 25px,#ffffff0c 25px 28px);transform:skew(-20deg);pointer-events:none}.heroinside{position:relative;z-index:1}.hero h2{font-size:27px;text-transform:none;letter-spacing:-.03em;margin:7px 0}.hero p{color:#c0cee6;max-width:680px}.kpis{display:flex;gap:7px;flex-wrap:wrap}.kpi{border:1px solid #ffffff20;background:#0b142655;padding:7px 10px;border-radius:10px;font-size:12px}.kpi b{color:var(--mint)}.sectionhead{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}.sectionhead h2{margin:0}.tabs{display:flex;gap:7px;overflow:auto;padding-bottom:3px}.tab{white-space:nowrap}.tab.active{background:var(--mint);color:#081322;border-color:var(--mint);font-weight:800}.actions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:12px}.action{min-height:92px;text-align:left;display:flex;flex-direction:column;align-items:flex-start;gap:5px;background:#101a2d}.action .emoji{font-size:21px}.action b{font-size:12px}.action small{color:var(--muted);font-size:11px}.two{display:grid;grid-template-columns:1fr 1fr;gap:15px}.feed,.places{display:grid;gap:8px;max-height:330px;overflow:auto}.event,.place{background:#0e1729;border:1px solid var(--line);border-radius:11px;padding:10px}.eventtop{display:flex;justify-content:space-between;gap:8px;font-size:12px;font-weight:800}.tag{color:var(--gold);font-size:10px;text-transform:uppercase;letter-spacing:.08em}.event p{margin:5px 0 0;color:#bdcbe3;font-size:12px}.place{display:flex;justify-content:space-between;align-items:center;gap:8px}.place b{font-size:12px}.place span{font-size:11px;color:var(--muted)}.place button{font-size:11px;padding:6px 8px}.muted{color:var(--muted)}.small{font-size:12px}.footer{text-align:center;color:#7184a7;font-size:11px;padding:14px}.modal{position:fixed;inset:0;background:#030711d9;display:none;place-items:center;padding:18px;z-index:10}.modal.show{display:grid}.modalbox{width:100%;max-width:500px;border:1px solid var(--line);border-radius:18px;background:#141e34;padding:21px}.modalbox h2{margin-top:0}.field{display:grid;gap:5px;margin:12px 0}.field input,.field select{width:100%;padding:10px;border:1px solid var(--line);border-radius:9px;background:#0b1427;color:var(--text)}.modalbuttons{display:flex;justify-content:flex-end;gap:8px;margin-top:16px}.notice{padding:10px;border:1px solid #3e665e;background:#102b2a;color:#baf6e1;border-radius:10px;font-size:12px}
@media(max-width:850px){.layout{grid-template-columns:1fr}.side{display:grid;grid-template-columns:1fr 1fr;gap:12px}.side .card{margin:0}.actions{grid-template-columns:repeat(2,minmax(0,1fr))}.hero h2{font-size:23px}}
@media(max-width:540px){.wrap{padding:11px}.side,.two{grid-template-columns:1fr}.actions{grid-template-columns:repeat(2,minmax(0,1fr))}.hero{min-height:0}.brand h1{font-size:19px}}
</style></head>
<body><div class="wrap">
<header class="top"><div class="brand"><div class="logo">◎</div><div><div class="eyebrow">A WORLD THAT KEEPS MOVING</div><h1>LIFE ON EARTH</h1><div class="sub">Open-world life simulator · browser prototype</div></div></div><div class="topbuttons"><button id="save">Save game</button><button id="load">Load game</button><button id="new" class="danger">New life</button></div></header>
<div class="layout">
<aside class="stack side">
<section class="card"><div class="person"><div class="avatar" id="avatar">👶</div><div><div class="name" id="name">Alex Morgan</div><div class="muted small" id="ageLine">Age 0 · Newborn</div></div></div><div class="chips"><span class="chip" id="country">🇮🇳 India</span><span class="chip" id="city">Kochi</span><span class="chip" id="status">Healthy</span></div><div class="cashlabel">CASH BALANCE</div><div class="cash" id="cash">₹0</div><div class="muted small" id="networth">Net worth ₹0</div></section>
<section class="card"><h2>Life stats</h2><div id="stats"></div></section>
<section class="card"><h2>Life overview</h2><div id="overview" class="small"></div></section>
<section class="card"><h2>Current situation</h2><div id="situation" class="muted small"></div></section>
</aside>
<main class="main">
<section class="card hero"><div class="heroinside"><div class="eyebrow" id="date">YEAR 2026 · EARTH</div><h2 id="headline">A whole world is waiting.</h2><p id="intro">Grow up, explore, make choices, build relationships, earn money and discover what your life becomes.</p><div class="kpis"><div class="kpi">Age <b id="kAge">0</b></div><div class="kpi">Health <b id="kHealth">100%</b></div><div class="kpi">Happiness <b id="kHappy">75%</b></div><div class="kpi">Reputation <b id="kRep">50</b></div><div class="kpi">Lifespan <b id="lifespan">Random</b></div></div></div></section>
<section class="card"><div class="sectionhead"><h2>Choose your next move</h2><span class="muted small" id="ageHint">Newborn stage</span></div><div class="tabs" id="tabs"><button class="tab active" data-tab="all">All activities</button><button class="tab" data-tab="life">Life</button><button class="tab" data-tab="career">Career & money</button><button class="tab" data-tab="world">Explore world</button><button class="tab" data-tab="risky">Risky choices</button></div><div class="actions" id="actions"></div></section>
<div class="two"><section class="card"><div class="sectionhead"><h2>World map</h2><span class="muted small">Destinations</span></div><div class="places" id="places"></div></section><section class="card"><div class="sectionhead"><h2>Life journal</h2><span class="muted small" id="entries">0 entries</span></div><div class="feed" id="journal"></div></section></div>
<section class="card"><div class="sectionhead"><h2>Time controls</h2><span class="muted small">One year at a time. Humans are inconveniently mortal.</span></div><div class="kpis"><button class="primary" id="year">▶ Advance 1 year</button><button id="day">Advance 1 day</button><button id="random">🎲 Random event</button><button id="rest">Rest & recover</button></div><p class="muted small">This is a playable 2D prototype with simulated choices and consequences, not a finished 3D world.</p></section>
</main></div><div class="footer">LIFE ON EARTH · Prototype 0.1 · Save locally in this browser.</div></div>
<div class="modal" id="modal"><div class="modalbox"><h2 id="mtitle">Create your life</h2><p class="muted small" id="mdesc">Configure the next life.</p><div id="mbody"></div><div class="modalbuttons"><button id="mcancel">Cancel</button><button id="mconfirm" class="primary">Confirm</button></div></div></div>
<script>
const $=id=>document.getElementById(id);
const countries=[
{name:"India",flag:"🇮🇳",cities:["Kochi","Mumbai","Delhi","Bengaluru","Chennai"],cost:1},{name:"United States",flag:"🇺🇸",cities:["New York","Los Angeles","Chicago","Seattle"],cost:3.8},{name:"United Kingdom",flag:"🇬🇧",cities:["London","Manchester","Edinburgh"],cost:3.2},{name:"Japan",flag:"🇯🇵",cities:["Tokyo","Osaka","Kyoto"],cost:2.8},{name:"Australia",flag:"🇦🇺",cities:["Sydney","Melbourne","Perth"],cost:3.5},{name:"Brazil",flag:"🇧🇷",cities:["São Paulo","Rio de Janeiro","Brasília"],cost:1.8},{name:"Canada",flag:"🇨🇦",cities:["Toronto","Vancouver","Montreal"],cost:3.4},{name:"France",flag:"🇫🇷",cities:["Paris","Lyon","Marseille"],cost:3.1},{name:"Nigeria",flag:"🇳🇬",cities:["Lagos","Abuja","Kano"],cost:1.3},{name:"United Arab Emirates",flag:"🇦🇪",cities:["Dubai","Abu Dhabi","Sharjah"],cost:3.7},{name:"South Africa",flag:"🇿🇦",cities:["Cape Town","Johannesburg","Durban"],cost:2}
];
const defaults=()=>({name:"Alex Morgan",country:"India",city:"Kochi",age:0,year:2026,day:1,lifespan:Math.floor(70+Math.random()*31),cash:0,assets:0,health:100,happiness:75,smarts:40,fitness:50,reputation:50,stress:8,education:"Not started",job:"None",business:"None",partner:"None",children:0,crime:0,criminalRecord:false,arrested:0,alive:true,retired:false,travelled:[],house:"Family home",skills:0,experience:0,events:0,days:0,journal:[],flags:{},ageEvents:[]});
let s=defaults(),activeTab="all",pending=null;
const fmt=n=>new Intl.NumberFormat("en-IN",{style:"currency",currency:"INR",maximumFractionDigits:0}).format(Math.round(n));
const clamp=n=>Math.max(0,Math.min(100,Math.round(n)));
function log(title,body,tag="Life event"){s.journal.unshift({title,body,tag,age:s.age,year:s.year});s.journal=s.journal.slice(0,80);}
function stage(){if(s.age===0)return"Newborn";if(s.age<3)return"Toddler";if(s.age<6)return"Early childhood";if(s.age<13)return"Child";if(s.age<18)return"Teenager";if(s.age<23)return"Young adult";if(s.age<40)return"Adult";if(s.age<60)return"Middle age";if(s.age<75)return"Older adult";return"Senior";}
function avatar(){if(s.age<2)return"👶";if(s.age<13)return"🧒";if(s.age<20)return"🧑";if(s.age<60)return"🧑‍💼";return"👴";}
function allowed(a){return s.alive&&s.age>=(a.min||0)&&s.age<=(a.max||130)&&(!a.cost||s.cash>=a.cost)&&!(a.id==="job"&&s.retired)&&!(a.id==="retire"&&s.retired);}
const A=[
{id:"family",tab:"life",icon:"🏡",title:"Spend time with family",desc:"Build bonds and happiness",min:0,run(){s.happiness=clamp(s.happiness+7);s.stress=clamp(s.stress-5);log("Family time","You spent quality time with your family. Relationships feel stronger.");}},
{id:"school",tab:"life",icon:"📚",title:"Attend school / study",desc:"Improve knowledge",min:5,max:25,run(){s.smarts=clamp(s.smarts+6);s.education=s.age<11?"Primary school":s.age<16?"Secondary school":s.age<19?"Higher secondary":s.education==="University degree"?s.education:"Higher education";s.stress=clamp(s.stress+3);log("Education","You studied and improved your knowledge.","Education");}},
{id:"sports",tab:"life",icon:"🏏",title:"Play sports",desc:"Fitness, skill and fun",min:4,run(){s.fitness=clamp(s.fitness+7);s.health=clamp(s.health+2);s.happiness=clamp(s.happiness+5);s.stress=clamp(s.stress-3);s.skills++;log("Sports day","You played sports and built fitness, confidence and teamwork.");}},
{id:"friends",tab:"life",icon:"🧑‍🤝‍🧑",title:"Make friends",desc:"Grow your social circle",min:5,run(){s.happiness=clamp(s.happiness+8);s.reputation=clamp(s.reputation+3);log("New friends","You met people and expanded your social circle.");}},
{id:"party",tab:"life",icon:"🎉",title:"Throw a party",desc:"Have fun; costs ₹5,000",min:16,cost:5000,run(){s.cash-=5000;s.happiness=clamp(s.happiness+14);s.stress=clamp(s.stress-8);s.reputation=clamp(s.reputation+2);log("Party night","You hosted a party. It was fun, and your wallet noticed.","Social");}},
{id:"date",tab:"life",icon:"💌",title:"Go on a date",desc:"Meet someone, age 16+",min:16,cost:500,run(){if(s.partner!=="None"){s.happiness=clamp(s.happiness+5);log("Date night","You went on a date with "+s.partner+".","Relationship");}else{s.partner=["Jamie","Riley","Taylor","Jordan","Sam"][Math.floor(Math.random()*5)];s.happiness=clamp(s.happiness+10);log("A new connection","You met "+s.partner+" and started dating. Take things respectfully and at your own pace.","Relationship");}}},
{id:"college",tab:"life",icon:"🎓",title:"Attend college",desc:"Higher education; costs ₹45,000",min:17,max:35,cost:45000,run(){s.cash-=45000;s.smarts=clamp(s.smarts+12);s.education="University degree";s.skills+=3;s.experience++;s.happiness=clamp(s.happiness+3);log("College enrolled","You enrolled in higher education. It cost money but expanded your options.","Education");}},
{id:"job",tab:"career",icon:"💼",title:"Find / do a job",desc:"Earn income and experience",min:16,run(){if(s.job==="None"){s.job=s.smarts>70?"Software developer":s.smarts>50?"Office assistant":"Retail worker";s.cash+=12000+s.smarts*180;s.experience++;log("First job","You got a job as a "+s.job+". Your career has started.","Career");}else{let income=12000+s.smarts*180+s.experience*600;s.cash+=income;s.experience++;s.stress=clamp(s.stress+5);log("Payday",`You worked as a ${s.job} and earned ${fmt(income)}.`,"Career");}}},
{id:"business",tab:"career",icon:"📈",title:"Start / run business",desc:"Invest ₹25,000; returns vary",min:18,cost:25000,run(){if(s.business==="None"){s.cash-=25000;s.business="Small local business";s.reputation=clamp(s.reputation+4);log("Business launched","You used ₹25,000 to start a small local business. Success is not guaranteed.","Business");}else{let profit=Math.round((Math.random()*2.2-.45)*18000+s.skills*900);s.cash+=profit;if(profit<0)s.reputation=clamp(s.reputation-2);else s.reputation=clamp(s.reputation+2);s.experience++;log("Business update",`Your business had a ${profit>=0?"profit":"loss"} of ${fmt(Math.abs(profit))}.`,"Business");}}},
{id:"invest",tab:"career",icon:"💹",title:"Invest savings",desc:"Markets can rise or fall",min:18,cost:1000,run(){let amount=Math.min(10000,Math.max(1000,Math.round(s.cash*.15)));if(s.cash<1000){log("Investment unavailable","You need at least ₹1,000 to invest.","Money");return;}s.cash-=amount;let result=Math.random()<.58?amount*(.1+Math.random()*.45):-amount*(.08+Math.random()*.55);s.cash+=amount+result;log("Investment result",`You invested ${fmt(amount)}. Your result was ${result>=0?"+":"−"}${fmt(Math.abs(result))}. Markets are unpredictable.`,"Money");}},
{id:"rest",tab:"life",icon:"🛌",title:"Rest and recharge",desc:"Recover health and stress",min:0,run(){s.health=clamp(s.health+10);s.happiness=clamp(s.happiness+4);s.stress=clamp(s.stress-12);log("Rest day","You slowed down and recovered some energy.");}},
{id:"travel",tab:"world",icon:"✈️",title:"Travel abroad",desc:"Discover another country",min:16,cost:20000,run(){let choices=countries.filter(c=>c.name!==s.country);let dest=choices[Math.floor(Math.random()*choices.length)];if(!s.travelled.includes(dest.name))s.travelled.push(dest.name);s.cash-=20000;s.city=dest.cities[Math.floor(Math.random()*dest.cities.length)];s.country=dest.name;log("New horizons",`You travelled to ${s.city}, ${dest.name}. New place, new people, new possibilities.`,"Travel");}},
{id:"explore",tab:"world",icon:"🚶",title:"Explore the city",desc:"Find places and opportunities",min:5,run(){let gain=Math.floor(Math.random()*1500);s.cash+=gain;s.happiness=clamp(s.happiness+5);s.reputation=clamp(s.reputation+1);let opts=["a lively street market","a public park","a local sports ground","a museum","a neighbourhood festival"];log("City exploration",`You explored ${opts[Math.floor(Math.random()*opts.length)]}${gain?` and found a small paid opportunity worth ${fmt(gain)}`:""}.`,"World");}},
{id:"move",tab:"world",icon:"🏙️",title:"Move to another city",desc:"A fresh start; costs ₹10,000",min:18,cost:10000,run(){let c=countries.find(x=>x.name===s.country)||countries[0],opts=c.cities.filter(x=>x!==s.city);if(!opts.length){log("Move unavailable","There are no other listed cities in this location.");return;}let old=s.city;s.city=opts[Math.floor(Math.random()*opts.length)];s.cash-=10000;log("A new address",`You moved from ${old} to ${s.city}. Moving cost ₹10,000.`,"World");}},
{id:"crime",tab:"risky",icon:"🚨",title:"Commit a crime",desc:"Illegal; consequences can follow",min:14,run(){let gain=Math.floor(1000+Math.random()*18000);if(Math.random()<.58){s.cash+=gain;s.crime++;s.reputation=clamp(s.reputation-8);s.happiness=clamp(s.happiness-3);log("Crime succeeded",`You gained ${fmt(gain)}, but the risk of consequences remains. Reputation fell.`,"Risky choice");}else{s.arrested++;s.criminalRecord=true;s.cash=Math.max(0,s.cash-5000);s.reputation=clamp(s.reputation-15);s.happiness=clamp(s.happiness-10);log("Arrested",`You were caught and received a criminal record. You lost ₹5,000 in penalties. Choices have consequences.`,"Legal trouble");}}},
{id:"volunteer",tab:"life",icon:"🤝",title:"Volunteer locally",desc:"Help others and build reputation",min:10,run(){s.happiness=clamp(s.happiness+6);s.reputation=clamp(s.reputation+7);s.stress=clamp(s.stress-3);log("Community service","You volunteered in your community and made a positive difference.");}},
{id:"retire",tab:"career",icon:"🌅",title:"Retire",desc:"Leave work behind",min:55,run(){s.retired=true;s.job="Retired";s.happiness=clamp(s.happiness+5);log("Retirement","You stepped away from work and began a new chapter.","Career");}},
{id:"familyfuture",tab:"life",icon:"👪",title:"Plan a family",desc:"Long-term commitment",min:21,run(){if(s.partner==="None"){log("Not yet","You need a partner before planning a family. Build relationships first.","Relationship");}else{s.children=Math.min(5,s.children+1);s.cash=Math.max(0,s.cash-12000);s.happiness=clamp(s.happiness+5);log("Family grows",`You and ${s.partner} welcomed a child. Family life brings joy and responsibility.`,"Family");}}}
];
function randomEvent(){if(!s.alive)return;const pool=[
()=>{s.cash+=2500;s.happiness=clamp(s.happiness+4);log("Unexpected good luck","A relative gave you ₹2,500 to help with expenses.","Random event");},
()=>{s.health=clamp(s.health-8);s.stress=clamp(s.stress+8);log("A rough week","You caught a minor illness and had to rest. Health took a small hit.","Health");},
()=>{s.happiness=clamp(s.happiness+9);s.reputation=clamp(s.reputation+3);log("A lucky break","You got an unexpected opportunity and met helpful people.","Random event");},
()=>{let bill=Math.min(s.cash,Math.floor(500+Math.random()*4000));s.cash-=bill;s.stress=clamp(s.stress+5);log("Unexpected expense",`A surprise bill cost ${fmt(bill)}. Life has a talent for paperwork.`,"Money");},
()=>{s.smarts=clamp(s.smarts+4);s.skills++;log("New skill","You picked up a useful skill that could help in school or work.","Growth");},
()=>{s.fitness=clamp(s.fitness+5);s.health=clamp(s.health+3);log("Healthy streak","A stretch of good habits improved your fitness and health.","Health");},
()=>{if(s.age>=16){s.partner=s.partner==="None"?"A new friend":s.partner;s.happiness=clamp(s.happiness+7);log("Someone important","You connected with someone who may become an important part of your life.","Relationship");}else{s.happiness=clamp(s.happiness+6);log("A memorable day","Something fun happened with friends and family.","Random event");}},
()=>{s.cash+=Math.max(0,Math.round(s.experience*1200));log("Small reward","Your effort paid off with a modest reward.","Money");}
];pool[Math.floor(Math.random()*pool.length)]();s.events++;render();}
function ageUp(){if(!s.alive)return;s.age++;s.year++;s.day=1;s.days+=365;s.health=clamp(s.health-(s.age>65?Math.floor(Math.random()*5):Math.floor(Math.random()*2)));s.happiness=clamp(s.happiness+(Math.random()*8-4));s.stress=clamp(s.stress+(Math.random()*6-2));if(s.age===5)log("School begins","You reached school age. Start studying to build knowledge.","Milestone");if(s.age===13)log("Teen years","You are now a teenager. New activities and responsibilities unlock.","Milestone");if(s.age===18)log("Adulthood","You are now an adult and can pursue college, work, travel and business.","Milestone");if(s.age===30)log("A new decade","You are 30. Your choices have started to shape your long-term story.","Milestone");if(s.age===60)log("A new chapter","You entered your sixties. Take care of your health and enjoy what you have built.","Milestone");
if(Math.random()<.42)randomEvent();if(s.age>=s.lifespan||s.health<=0){s.alive=false;log("Life story complete",`${s.name}'s life ended at age ${s.age}. Final net worth: ${fmt(s.cash+s.assets)}. Start a new life to explore another path.`,"Life ending");}render();}
function ageDay(){if(!s.alive)return;s.day++;s.days++;if(s.day>30){s.day=1;s.year++;}if(Math.random()<.13)randomEvent();else render();}
