const npcs=[];for(let i=0;i<10;i++){let g=new THREE.Group();g.position.set(-32+Math.random()*64,0,-5+Math.random()*35);g.rotation.y=Math.random()*Math.PI*2;scene.add(g);box(.7,1,.4,mat([0x9a6dd7,0x3d9c81,0xd77d54,0xd4bc51][i%4]),0,1.35,0,g);let h=new THREE.Mesh(new THREE.SphereGeometry(.3,12,10),skin);h.position.y=2.05;g.add(h);cylinder(.07,.07,.6,dark,-.18,.35,0,g);cylinder(.07,.07,.6,dark,.18,.35,0,g);npcs.push({g,phase:Math.random()*6})}
